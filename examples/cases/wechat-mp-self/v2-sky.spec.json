  "article": {
    "title": "公众号配图交给脚本：wechat-mp 的五步出稿法",
    "summary": "公众号内容自动化清单：从主题到能发只差五步，贴图、长文、封面、视频号同源产出，自检 0 fail 才交付。",
    "topbar": "项目清单｜栏目「公众号内容工坊」｜事实据仓库源码与 README 整理",
    "cover": {
      "kicker": "CONTENT PIPELINE · 五步",
      "title": [
        "五步出稿清单",
        "公众号内容自动化"
      ],
      "accent": "五步",
      "sub": "立项 → 版式 → 文案 → 出图 → 自检",
      "hero": {
        "type": "checklist",
